{
  "name": "famicom-tank-battle",
  "version": "0.1.0",
  "private": true,
  "description": "A Famicom-style tank battle game for browser and macOS app.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "compare": "node scripts/compare-screenshots.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "app": "npm run build && electron .",
    "app:dev": "APP_DEV_URL=http://localhost:5173 electron .",
    "app:pack": "npm run build && electron-builder --mac dir"
  },
  "keywords": [
    "tank",
    "canvas",
    "game",
    "electron"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "local.famicom.tankbattle",
    "productName": "Famicom Tank Battle",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dir"
      ]
    }
  }
}
